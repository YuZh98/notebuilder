            "slots": [
              {
                "type": "choice",
                "props": {
                  "q": "Adding a covariate to an OLS model can never...",
                  "options": [
                    "increase R²",
                    "decrease R²",
                    "change β̂ of other covariates",
                    "decrease adjusted R²"
                  ],
                  "answer": [
                    1
                  ],
                  "explanation": "Plain $R^2$ is non-decreasing in added covariates; that is exactly why adjusted $R^2$ exists."
                }
              }
            ]

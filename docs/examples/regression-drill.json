        "name": "Part I · Definitions",
        "kind": "divider",
        "cards": []
      },
      {
        "name": "Core objects",
        "cards": [
          {
            "verbs": {
              "flip": true
            },
            "tags": [
              "definition"
            ],
            "slots": [
              {
                "type": "text",
                "props": {
                  "text": "**Flip me.** What does the OLS estimator $\\hat\\beta$ minimize?"
                }
              }
            ],
            "back": [
              {
                "type": "text",
                "props": {
                  "text": "The residual sum of squares:\n\n$$\\hat\\beta = \\arg\\min_\\beta \\; \\lVert y - X\\beta \\rVert^2 = (X^\\top X)^{-1} X^\\top y$$"
                }
              }
            ]
          },
          {
            "verbs": {
              "flip": true
            },
            "tags": [
              "definition"
            ],
            "slots": [
              {
                "type": "text",
                "props": {
                  "text": "**Flip me.** What does $R^2$ measure, and what is its range?"
                }
              }
            ],
            "back": [
              {
                "type": "text",
                "props": {
                  "text": "The share of variance in $y$ explained by the fit: $R^2 = 1 - \\mathrm{RSS}/\\mathrm{TSS}$, in $[0, 1]$ for a model with intercept."
                }
              }
            ]
          },
          {
            "tags": [
              "definition"
            ],
            "slots": [
              {
                "type": "table",
                "props": {
                  "rows": [
                    [
                      "Symbol",
                      "Meaning"
                    ],
                    [
                      "X",
                      "n × p design matrix"
                    ],
                    [
                      "β̂",
                      "fitted coefficients"
                    ],
                    [
                      "H = X(XᵀX)⁻¹Xᵀ",
                      "hat matrix, projects y onto the column space"
                    ],
                    [
                      "e = y − ŷ",
                      "residuals, orthogonal to the columns of X"
                    ]
                  ]
                }
              }
            ]
          }
        ]
      },
      {

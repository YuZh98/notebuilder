                  "text": "### Python sandbox\n\nThe original terminal runs this in the browser; here the card carries the exact script for your own REPL."
                }
              },
              {
                "type": "code",
                "props": {
                  "lang": "python",
                  "code": "import numpy as np\n\ndef mc_call(s0=100, k=100, vol=0.2, t=0.25, r=0.0, n=100_000, seed=7):\n    rng = np.random.default_rng(seed)\n    z = rng.standard_normal(n)\n    st = s0 * np.exp((r - 0.5 * vol**2) * t + vol * np.sqrt(t) * z)\n    return np.exp(-r * t) * np.maximum(st - k, 0).mean()\n\nprint(f\"MC call: {mc_call():.4f}\")  # ~4.00 at these params"
                }
              }
            ]
          },

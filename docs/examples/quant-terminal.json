                  "text": "`PROBABILITY`\n\n**Monty Hall: switch or stay?**"
                }
              }
            ],
            "back": [
              {
                "type": "text",
                "props": {
                  "text": "**Switch.** Staying wins iff the first pick was right: $1/3$. Switching wins the other $2/3$. The host opening a goat door moves no probability onto your original door."
                }
              }
            ]

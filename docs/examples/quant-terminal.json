            "slots": [
              {
                "type": "text",
                "props": {
                  "text": "### Payoff explorer: iron butterfly\n\nShort a straddle at $K_0$, buy wings $W$ away, collect net credit $C$. The three sliders write the card scope; everything below derives from it."
                }
              },
              {
                "type": "slider",
                "props": {
                  "key": "K0",
                  "value": 100,
                  "min": 80,
                  "max": 120,
                  "step": 5
                },
                "w": 4,
                "verbs": {
                  "hint": {
                    "content": "`K0` is the short straddle strike, the tent pole."
                  }
                }
              },
              {
                "type": "slider",
                "props": {
                  "key": "W",
                  "value": 10,
                  "min": 5,
                  "max": 25,
                  "step": 5
                },
                "w": 4,
                "verbs": {
                  "hint": {
                    "content": "`W` is the wing width: the long put sits at K0 - W, the long call at K0 + W."
                  }
                }
              },
              {
                "type": "slider",
                "props": {
                  "key": "C",
                  "value": 3.5,
                  "min": 1,
                  "max": 8,
                  "step": 0.25
                },
                "w": 4,
                "verbs": {
                  "hint": {
                    "content": "`C` is the net credit collected up front. In a full pricer it would come from Black-Scholes; here you set it."
                  }
                }
              },
              {
                "type": "compute",
                "props": {
                  "expr": "C",
                  "out": "maxProfit",
                  "note": "max profit"
                },
                "w": 3
              },
              {
                "type": "compute",
                "props": {
                  "expr": "C - W",
                  "out": "maxLoss",
                  "note": "max loss"
                },
                "w": 3
              },
              {
                "type": "compute",
                "props": {
                  "expr": "K0 - C",
                  "out": "beLow",
                  "note": "breakeven low"
                },
                "w": 3
              },
              {
                "type": "compute",
                "props": {
                  "expr": "K0 + C",
                  "out": "beHigh",
                  "note": "breakeven high"
                },
                "w": 3
              },
              {
                "type": "chart",
                "props": {
                  "fn": "C - max(K0 - x, 0) - max(x - K0, 0) + max(K0 - W - x, 0) + max(x - K0 - W, 0)",
                  "label": "P&L at expiry vs spot",
                  "x0": 60,
                  "x1": 140,
                  "y0": -25,
                  "y1": 10,
                  "xticks": 8,
                  "yticks": 7,
                  "hover": true
                }
              },

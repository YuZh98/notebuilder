                "type": "text",
                "props": {
                  "text": "Profit tent peaks at **{{maxProfit}}** on $K_0 = {{K0}}$, floors at **{{maxLoss}}** beyond the wings, and crosses zero at **{{beLow}}** and **{{beHigh}}**. Widen $W$ and the floor drops; fatten $C$ and the tent grows."
                },
                "verbs": {
                  "glow": true
                }
              }
